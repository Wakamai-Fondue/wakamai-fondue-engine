{
	"name": "@wakamai-fondue/engine",
	"version": "1.3.0",
	"type": "module",
	"description": "What if you could actually inspect your web fonts? In the same context that you actually use those web fonts? That's what this is for.",
	"exports": {
		".": {
			"browser": "./browser.js",
			"node": "./node.js"
		}
	},
	"directories": {
		"test": "test"
	},
	"scripts": {
		"coverage": "vitest --coverage --run",
		"test": "vitest --run",
		"lint": "npm-run-all lint:**",
		"lint:eslint": "eslint .",
		"lint:prettier": "prettier --check .",
		"lint-fix": "npm-run-all --sequential lint-fix:** prettier",
		"lint-fix:eslint": "eslint --fix .",
		"prettier": "prettier --write .",
		"prepare": "husky"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Wakamai-Fondue/wakamai-fondue-engine.git"
	},
	"keywords": [
		"font",
		"ttf",
		"woff",
		"woff2",
		"otf",
		"fontkit",
		"opentype",
		"lib-font",
		"layout",
		"css"
	],
	"author": "RoelN",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/Wakamai-Fondue/wakamai-fondue-engine/issues"
	},
	"homepage": "https://wakamaifondue.com/",
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@vitest/coverage-v8": "4.1.11",
		"eslint": "10.9.1",
		"globals": "17.11.0",
		"husky": "9.1.7",
		"lint-staged": "17.3.0",
		"npm-run-all": "4.1.5",
		"prettier": "3.9.6",
		"vitest": "4.1.11"
	},
	"lint-staged": {
		"*.{js,cjs,mjs,json,md}": [
			"prettier --write"
		]
	},
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"lib-font": "^3.0.4"
	},
	"allowScripts": {
		"esbuild@0.21.5": true,
		"fsevents@2.3.3": true
	}
}
